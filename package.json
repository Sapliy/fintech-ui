{
    "name": "@sapliyio/fintech-ui",
    "version": "1.1.0",
    "description": "Premium React components for Sapliy Fintech Ecosystem",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles.css": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && tailwindcss -i ./src/styles/index.css -o ./dist/index.css",
        "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "clsx": "^2.1.0",
        "framer-motion": "^11.0.8",
        "lucide-react": "^0.344.0",
        "tailwind-merge": "^2.2.1"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.2.6",
        "@storybook/addon-docs": "^10.2.6",
        "@storybook/addon-onboarding": "^10.2.6",
        "@storybook/react-vite": "^10.2.6",
        "@tailwindcss/cli": "^4.1.18",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.4.0",
        "@testing-library/react": "^14.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^4.0.18",
        "autoprefixer": "^10.4.24",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-storybook": "^10.2.6",
        "jsdom": "^24.0.0",
        "postcss": "^8.5.6",
        "storybook": "^10.2.6",
        "tailwindcss": "^4.0.0",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "vitest": "^4.0.18"
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    }
}
